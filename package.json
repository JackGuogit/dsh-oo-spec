{
  "name": "dsh-oo-spec",
  "version": "1.0.1",
  "description": "OO design spec for DeepSeek Harness: a skill that routes requirement 鈫?domain 鈫?design 鈫?implementation through four gates and nine judgement cards, five tools that search, read, anchor, and mechanically check a deliverable, and an in-app spec browser.",
  "type": "module",
  "license": "MIT",
  "author": "JackGuo",
  "homepage": "https://github.com/JackGuogit/dsh-oo-spec",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackGuogit/dsh-oo-spec.git"
  },
  "bugs": {
    "url": "https://github.com/JackGuogit/dsh-oo-spec/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "oo",
    "object-oriented",
    "design-spec",
    "requirements",
    "domain-model",
    "solid",
    "skill"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "spec",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node scripts/selftest.mjs && node scripts/client-smoke.mjs",
    "test:host": "node scripts/selftest.mjs",
    "test:client": "node scripts/client-smoke.mjs"
  },
  "engines": {
    "dsh": ">=0.2.1"
  }
}
